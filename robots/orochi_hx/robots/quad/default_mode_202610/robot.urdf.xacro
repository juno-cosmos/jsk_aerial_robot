<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="orochi_hx" >

  <!-- basic kinematics model -->
  <xacro:include filename="$(find orochi_hx)/urdf/orochi_hx_common.xacro" />
  <xacro:include filename="$(find orochi_hx)/urdf/orochi_hx_link.urdf.xacro" />

  <xacro:orochi_hx_link links="4" self="1" rotor_direction="-1"/>
  <xacro:orochi_hx_link links="4" self="2" rotor_direction="1"/>
  <xacro:orochi_hx_link links="4" self="3" rotor_direction="-1"/>
  <xacro:orochi_hx_link links="4" self="4" rotor_direction="1"/>

  <!-- special battery arrangement -->

  <!-- onboard -->

</robot>

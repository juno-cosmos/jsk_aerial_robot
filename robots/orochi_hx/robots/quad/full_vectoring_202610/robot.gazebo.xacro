<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="orochi_hx" >

  <xacro:arg name="robot_name" default="orochi_hx" />

  <!-- robot urdf -->
  <xacro:include filename="$(find orochi_hx)/robots/quad/full_vectoring_202610/robot.urdf.xacro" />

  <!-- gazebo plugin for default controller and sensors -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.gazebo.xacro" />
  <xacro:gazebo_spinal robot_name="$(arg robot_name)" />

</robot>
